#!/bin/sh
# Runs the quick checks before a push and stops the push when one fails: the private-data scan, which must run
# before anything is public, and the formatting checks. The pipeline runs all checks (scripts/check.ps1).
# Enable once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v pwsh > /dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check.ps1 -Quick
fi
# Windows PowerShell refuses local scripts by default; Bypass applies to this one process only
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1 -Quick
