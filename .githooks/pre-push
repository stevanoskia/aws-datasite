#!/bin/sh
# Runs every check before a push and stops the push when one fails.
# Enable once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v pwsh > /dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check.ps1
fi
# Windows PowerShell refuses local scripts by default; Bypass applies to this one process only
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1
