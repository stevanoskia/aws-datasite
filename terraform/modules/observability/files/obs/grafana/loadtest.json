{
 "uid": "loadtest",
 "title": "Load test",
 "description": "The traffic as k6 sees it (loadgen/): rate, answers and duration per endpoint, for each profile",
 "tags": [
  "aws-datasite"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "profile",
    "label": "Profile",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(k6_http_reqs_total, profile)",
     "refId": "profile"
    },
    "definition": "label_values(k6_http_reqs_total, profile)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second, by endpoint",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(k6_http_reqs_total{profile=~\"$profile\"}[1m]))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Unexpected answers, share of all requests",
   "description": "Answers that are not in the request's list of expected statuses (loadgen/shop.js)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(k6_http_reqs_total{profile=~\"$profile\",expected_response=\"false\"}[5m])) / sum(rate(k6_http_reqs_total{profile=~\"$profile\"}[5m]))",
     "legendFormat": "unexpected %"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Duration of all requests: p50, p95, p99",
   "description": "As k6 sees it, network included. Fixed buckets: values between two bucket limits are estimates",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket{profile=~\"$profile\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket{profile=~\"$profile\"}[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket{profile=~\"$profile\"}[5m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Duration p95, by endpoint",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, name) (rate(k6_http_req_duration_milliseconds_bucket{profile=~\"$profile\"}[5m])))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Responses per second, by status",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(k6_http_reqs_total{profile=~\"$profile\"}[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Time to first byte p95, by endpoint",
   "description": "Waiting for the server's answer: mostly the app and the database",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, name) (rate(k6_http_req_waiting_milliseconds_bucket{profile=~\"$profile\"}[5m])))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Virtual users, by profile",
   "description": "With an arrival rate, more users mean slower answers: k6 adds users to keep the rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (profile) (k6_vus{profile=~\"$profile\"})",
     "legendFormat": "{{profile}} active"
    },
    {
     "refId": "B",
     "expr": "sum by (profile) (k6_vus_max{profile=~\"$profile\"})",
     "legendFormat": "{{profile}} allocated"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Requests per second, by profile and seed",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (profile, seed) (rate(k6_http_reqs_total{profile=~\"$profile\"}[1m]))",
     "legendFormat": "{{profile}} seed {{seed}}"
    }
   ]
  }
 ]
}
