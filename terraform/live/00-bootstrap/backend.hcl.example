# Copy to backend.hcl (git-ignored) after the first apply, fill in the bucket name
# from `terraform output state_bucket_name`, then run:
#   terraform init -migrate-state -backend-config=backend.hcl
bucket       = "aws-datasite-tfstate-xxxxxx"
key          = "00-bootstrap/terraform.tfstate"
region       = "eu-north-1"
use_lockfile = true
encrypt      = true
